bounce = 0.05

; The M1 test rig: a heavy core wearing four bolted-on armour panels, carried on
; stubby feet. Heavy enough (150 kg) that it stays put and stays hittable rather
; than skating away, but still a rigid body so the welds see realistic loads.
;
; The feet are not decoration. Rest the core straight on the floor and each
; panel carries a share of 150 kg -- hundreds of newtons of standing contact
; force, which reads as damage before anything has hit it. Real armour is bolted
; to a chassis that rides on wheels and bears no weight; these panels do the
; same, hanging 60 mm clear of the floor where the plow's ramp can reach them.
[node name="PanelDummy" type="RigidBody3D"]
mass = 150.0
physics_material_override = SubResource("PhysicsMaterial_core")
center_of_mass_mode = 1
center_of_mass = Vector3(0, -0.12, 0)
continuous_cd = true
can_sleep = false

